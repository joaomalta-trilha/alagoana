# Postgres.app local. Em produção use a URL do banco gerenciado.
DATABASE_URL=postgres://localhost:5432/alagoana
# Fuso das datas de negócio. Maceió não tem horário de verão.
TZ=America/Maceio
# Porta do servidor.
PORT=3000
# Cookie de sessão com a marca Secure. Ligue (=1) só onde houver HTTPS —
# em http://localhost o navegador simplesmente não devolveria o cookie.
COOKIE_SEGURO=0
# Quantos proxies existem na frente do processo. 0 em desenvolvimento; 1 atrás
# do Render. Errar para mais deixa qualquer um forjar o próprio IP; errar para
# menos faz o freio de login tratar todo mundo como um visitante só.
CONFIAR_PROXY=0
